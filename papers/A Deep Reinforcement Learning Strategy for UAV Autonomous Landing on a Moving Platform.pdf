               <rdf:li xml:lang="x-default">J Intell Robot Syst, doi:10.1007/s10846-018-0891-8</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Deep reinforcement learning</rdf:li>
               <rdf:li>UAV</rdf:li>
               <rdf:li>Autonomous landing</rdf:li>
               <rdf:li>Continuous control</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A Deep Reinforcement Learning Strategy for UAV Autonomous Landing on a Moving Platform</rdf:li>
            </rdf:Alt>
         </dc:title>
